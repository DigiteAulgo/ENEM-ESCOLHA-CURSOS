@model IEnumerable<AppCursosUniversitarios.Models.Curso>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomeCurso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Turno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CargaHoraria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VagasDisponiveis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EscolhaCursos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NomeCurso)
            </td>
            <td>
                @Html.DisplayFor(model => item.Turno)
            </td>
            <td>
                @Html.DisplayFor(model => item.CargaHoraria)
            </td>
            <td>
                @Html.DisplayFor(model => item.VagasDisponiveis)
            </td>
            <td>
                @Html.DisplayFor(model => item.EscolhaCursos)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
